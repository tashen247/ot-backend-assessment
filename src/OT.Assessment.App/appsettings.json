{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DatabaseConnection": "SERVER=.; DATABASE=OT_Assessment_DB; Integrated Security=SSPI; TrustServerCertificate=True;"
  },
  "Caching": {
    "TopSpendersSeconds": 5,
    "RedisConnectionString": "localhost:6379",
    "RedisInstanceName": "ot-assessment:",
    "RedisTimeoutMilliseconds": 250,
    "RedisCircuitBreaker": {
      "FailureRatio": 0.5,
      "MinimumThroughput": 10,
      "SamplingDurationSeconds": 5,
      "BreakDurationSeconds": 30
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "ot.casino",
    "RoutingKey": "casino.wager",
    "Queue": "ot.casino.wagers",
    "DeadLetterExchange": "ot.casino.dlx",
    "DeadLetterQueue": "ot.casino.wagers.dead",
    "PublisherChannelPoolSize": 16,
    "PublishTimeoutMilliseconds": 5000,
    "PublishCircuitBreaker": {
      "FailureRatio": 0.5,
      "MinimumThroughput": 20,
      "SamplingDurationSeconds": 10,
      "BreakDurationSeconds": 15
    }
  }
}
